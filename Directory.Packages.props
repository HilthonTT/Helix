<Project>

	<!--
	Central Package Management: every NuGet version for the whole solution lives here,
	and the individual .csproj files reference packages without a Version attribute.
	This makes it impossible for one project to be bumped while another lags behind,
	which is what produced the NU1605 package-downgrade errors.
	-->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup Label="MAUI">
		<PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.90" />
		<PackageVersion Include="CommunityToolkit.Maui" Version="15.0.0" />
		<PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup Label="Charts">
		<!-- Microcharts 2.0.0.3 is built against SkiaSharp 3.119.x; keep SkiaSharp on the
		     same major so the chart rendering path stays binary-compatible. -->
		<PackageVersion Include="Microcharts.Maui" Version="2.0.0.3" />
		<PackageVersion Include="SkiaSharp.Views.Maui.Controls" Version="3.119.4" />
	</ItemGroup>

	<ItemGroup Label="Data">
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
		<!--
		Sqlite.Core deliberately, not Sqlite: the full package bundles SQLitePCLRaw.bundle_e_sqlite3,
		which ships a second native SQLite (flagged by GHSA-2m69-gcr7-jv3q) and competes with
		bundle_e_sqlcipher over which provider SQLitePCL.Batteries_V2 initializes. Helix always wants
		the SQLCipher build, so only that bundle is referenced.
		-->
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.10" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10" />
		<PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
	</ItemGroup>

	<ItemGroup Label="Platform">
		<PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
		<PackageVersion Include="SharpHook" Version="5.3.8" />
	</ItemGroup>

	<ItemGroup Label="Testing">
		<PackageVersion Include="coverlet.collector" Version="6.0.4" />
		<!-- FluentAssertions 8.x moved to a paid commercial licence; 6.x/7.x stay Apache-2.0. -->
		<PackageVersion Include="FluentAssertions" Version="6.12.2" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
		<PackageVersion Include="NSubstitute" Version="5.3.0" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
	</ItemGroup>

</Project>
