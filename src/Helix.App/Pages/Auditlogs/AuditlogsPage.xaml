<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Helix.App.Models"
             xmlns:icons="clr-namespace:Helix.App.Icons"
             xmlns:auditlogTemplates="clr-namespace:Helix.App.Views.Auditlogs"
             xmlns:auditlogs="clr-namespace:Helix.App.Pages.Auditlogs"
             xmlns:searchAuditlogs="clr-namespace:Helix.App.Modals.Auditlogs.Search"
             xmlns:local="clr-namespace:Helix.App"
             x:Class="Helix.App.Pages.Auditlogs.AuditlogsPage"
             x:DataType="auditlogs:AuditlogsViewModel"
             Title="">

    <Grid>

        <Grid RowDefinitions="Auto,*" RowSpacing="20" Padding="28,24">

            <!-- ===== Page header ===== -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{local:Translate Auditlogs}" Style="{StaticResource Display}"/>
                <Label Style="{StaticResource Muted}"
                       Text="{Binding Source={x:Static local:LocalizationResourceManager.Instance}, Path=CurrentDate, x:DataType=local:LocalizationResourceManager}"/>
            </VerticalStackLayout>

            <!-- ===== Log list ===== -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,Auto,*" Padding="20">

                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,16">
                        <Label Text="{local:Translate YourAuditlogs}"
                               Style="{StaticResource Title1}"
                               VerticalOptions="Center"/>

                        <Border Grid.Column="1" Style="{StaticResource PillNeutral}" Padding="9,3">
                            <Label Text="{Binding Auditlogs.Count}"
                                   Style="{StaticResource Caption}"
                                   FontFamily="{StaticResource FontMonoBold}"/>
                        </Border>

                        <Border Grid.Column="3"
                                Style="{StaticResource Chip}"
                                SemanticProperties.Description="Opens the audit log filter">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSearchAuditlogsModalCommand}"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="9" InputTransparent="True">
                                <Label Text="{x:Static icons:IconFont.Filter}"
                                       Style="{StaticResource IconSm}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                                <Label Text="{local:Translate Filter}" FontSize="13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Column headers, aligned to AuditlogTemplate's grid -->
                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="10"
                                         IsVisible="{Binding Auditlogs.Count, Converter={StaticResource CountToBoolConverter}}">
                        <Grid ColumnDefinitions="Auto,*,200" ColumnSpacing="14" Padding="12,0">
                            <Label Text=" " Style="{StaticResource Overline}" WidthRequest="7"/>
                            <Label Grid.Column="1" Text="{local:Translate Message}" Style="{StaticResource Overline}"/>
                            <Label Grid.Column="2"
                                   Text="{local:Translate Date}"
                                   Style="{StaticResource Overline}"
                                   HorizontalTextAlignment="End"/>
                        </Grid>

                        <BoxView Style="{StaticResource Divider}"/>
                    </VerticalStackLayout>

                    <ScrollView Grid.Row="2"
                                Margin="0,8,0,0"
                                IsVisible="{Binding Auditlogs.Count, Converter={StaticResource CountToBoolConverter}}">
                        <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Auditlogs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:AuditlogDisplay">
                                    <auditlogTemplates:AuditlogTemplate BindingContext="{Binding .}"/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Empty state -->
                    <VerticalStackLayout Grid.Row="1"
                                         Grid.RowSpan="2"
                                         Spacing="10"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         IsVisible="{Binding Auditlogs.Count, Converter={StaticResource CountToBoolConverter}, ConverterParameter=invert}">
                        <Border Style="{StaticResource IconTile}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Center">
                            <Label Text="{x:Static icons:IconFont.History}"
                                   Style="{StaticResource IconLg}"
                                   TextColor="{StaticResource Brand}"/>
                        </Border>

                        <Label Text="{local:Translate NoAuditlogsTitle}"
                               Style="{StaticResource Title2}"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="{local:Translate NoAuditlogsMessage}"
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="360"/>
                    </VerticalStackLayout>

                </Grid>
            </Border>
        </Grid>

        <!-- ===== Modal layer ===== -->
        <BoxView x:Name="BlockScreen"
                 Color="{StaticResource Black}"
                 Opacity="0"
                 InputTransparent="True"/>

        <AbsoluteLayout x:Name="SearchAuditlogsLayout" IsVisible="False">
            <searchAuditlogs:SearchAuditlogsModal x:Name="SearchAuditlogsView"
                                                  WidthRequest="460"
                                                  AbsoluteLayout.LayoutBounds="0.5,0.5,-1,-1"
                                                  AbsoluteLayout.LayoutFlags="PositionProportional"/>
        </AbsoluteLayout>

    </Grid>

</ContentPage>
