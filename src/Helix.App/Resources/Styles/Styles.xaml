<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:Helix.App.Behaviors">

    <x:String x:Key="FontRegular">OpenSansRegular</x:String>
    <x:String x:Key="FontSemibold">OpenSansSemibold</x:String>
    <x:String x:Key="FontMono">SpaceMonoRegular</x:String>
    <x:String x:Key="FontMonoBold">SpaceMonoBold</x:String>
    <x:String x:Key="FontIcon">FontAwesome</x:String>

    <x:String x:Key="SpaceMonoRegular">SpaceMonoRegular</x:String>
    <x:String x:Key="SpaceMonoBold">SpaceMonoBold</x:String>

    <x:Double x:Key="RadiusSm">8</x:Double>
    <x:Double x:Key="RadiusMd">12</x:Double>
    <x:Double x:Key="RadiusLg">16</x:Double>
    <x:Double x:Key="RadiusPill">999</x:Double>

    <Style x:Key="BaseStyle" TargetType="Element">
        <Setter Property="Shell.BackgroundColor"
                Value="{DynamicResource Surface}"/>
        <Setter Property="Shell.ForegroundColor"
                Value="{DynamicResource Text}"/>
        <Setter Property="Shell.TitleColor"
                Value="{DynamicResource Text}"/>
        <Setter Property="Shell.NavBarHasShadow" Value="False"/>
    </Style>

    <Style BasedOn="{StaticResource BaseStyle}" ApplyToDerivedTypes="True" TargetType="FlyoutItem"/>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background"
                Value="{DynamicResource CanvasBrush}"/>
        <Setter Property="Shell.NavBarIsVisible" Value="False"/>
    </Style>

    <Style x:Key="LabelBase" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="1.35"/>
        <Setter Property="TextColor"
                Value="{DynamicResource Text}"/>
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource LabelBase}"/>

    <Style x:Key="Display" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="LineHeight" Value="1.2"/>
    </Style>

    <Style x:Key="Title1" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="LineHeight" Value="1.25"/>
    </Style>

    <Style x:Key="Title2" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="Title3" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="BodyStrong" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
    </Style>

    <Style x:Key="Muted" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="TextColor"
                Value="{DynamicResource TextMuted}"/>
    </Style>

    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor"
                Value="{DynamicResource TextMuted}"/>
    </Style>

    <Style x:Key="Faint" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor"
                Value="{DynamicResource TextFaint}"/>
    </Style>

    <Style x:Key="Overline" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CharacterSpacing" Value="0.9"/>
        <Setter Property="TextColor"
                Value="{DynamicResource TextFaint}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor"
                Value="{DynamicResource TextMuted}"/>
    </Style>

    <Style x:Key="Mono" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    </Style>

    <Style x:Key="Metric" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontMonoBold}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="LineHeight" Value="1.1"/>
    </Style>

    <Style x:Key="SuccessText" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="TextColor"
                Value="{DynamicResource Success}"/>
    </Style>

    <Style x:Key="DangerText" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="TextColor"
                Value="{DynamicResource Danger}"/>
    </Style>

    <Style x:Key="WarningText" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="TextColor"
                Value="{DynamicResource Warning}"/>
    </Style>

    <Style x:Key="BrandText" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="TextColor" Value="{DynamicResource Accent}"/>
    </Style>

    <Style x:Key="Icon" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontIcon}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineHeight" Value="1"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="IconSm" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="IconLg" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Stroke"
                Value="{DynamicResource BorderBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=16}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="CardInteractive" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="behaviors:Hover.Background"
                Value="{DynamicResource SurfaceAlt}"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
    </Style>

    <Style x:Key="CardInset" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=12}"/>
    </Style>

    <Style x:Key="IconTile" TargetType="Border" BasedOn="{StaticResource CardInset}">
        <Setter Property="WidthRequest" Value="40"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=11}"/>
    </Style>

    <!-- The stroke is always two wide and the padding two short of what the row wants, so
         the focus ring appears and disappears without moving the columns off the header. -->
    <Style x:Key="Row" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=12}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="behaviors:Hover.Background"
                Value="{DynamicResource SurfaceAlt}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="Transparent"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=999}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style x:Key="PillSuccess" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background"
                Value="{DynamicResource SuccessWashBrush}"/>
    </Style>

    <Style x:Key="PillDanger" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background"
                Value="{DynamicResource DangerWashBrush}"/>
    </Style>

    <Style x:Key="PillWarning" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background"
                Value="{DynamicResource WarningWashBrush}"/>
    </Style>

    <Style x:Key="PillNeutral" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background"
                Value="{DynamicResource SurfaceAltBrush}"/>
    </Style>

    <Style x:Key="Tick" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Stroke"
                Value="{DynamicResource BorderControl}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=5}"/>
        <Setter Property="WidthRequest" Value="18"/>
        <Setter Property="HeightRequest" Value="18"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="TickChecked" TargetType="Border" BasedOn="{StaticResource Tick}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource SurfaceRaisedBrush}"/>
        <Setter Property="Stroke"
                Value="{DynamicResource BorderBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=10}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="behaviors:Hover.Background"
                Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
    </Style>

    <Style x:Key="IconHit" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=8}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="WidthRequest" Value="26"/>
        <Setter Property="HeightRequest" Value="26"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="behaviors:Hover.Background"
                Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
    </Style>

    <Style x:Key="IconChip" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Stroke"
                Value="{DynamicResource BorderBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=9}"/>
        <Setter Property="WidthRequest" Value="32"/>
        <Setter Property="HeightRequest" Value="32"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="behaviors:Hover.Background"
                Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
    </Style>

    <Style x:Key="Sheet" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Stroke"
                Value="{DynamicResource BorderBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=18}"/>
        <Setter Property="Shadow">
            <Shadow Brush="Black" Offset="0,18" Radius="40" Opacity="0.35"/>
        </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="Color"
                Value="{DynamicResource Border}"/>
        <Setter Property="HeightRequest" Value="1"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="#FFFFFF"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="MinimumHeightRequest" Value="42"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}"/>
                            <Setter Property="Scale" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentPressed}"/>
                            <Setter Property="Scale" Value="0.98"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{DynamicResource SurfaceHover}"/>
                            <Setter Property="TextColor"
                                    Value="{DynamicResource TextFaint}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonSecondary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="MinimumHeightRequest" Value="42"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="BorderColor"
                Value="{DynamicResource Border}"/>
        <Setter Property="TextColor"
                Value="{DynamicResource Text}"/>
        <Setter Property="BackgroundColor"
                Value="{DynamicResource SurfaceRaised}"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{DynamicResource SurfaceHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{DynamicResource TextFaint}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonDanger" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="#FFFFFF"/>
        <Setter Property="BackgroundColor"
                Value="{StaticResource DangerSolid}"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="MinimumHeightRequest" Value="42"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DangerSolidHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{DynamicResource SurfaceHover}"/>
                            <Setter Property="TextColor"
                                    Value="{DynamicResource TextFaint}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonGhost" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="TextColor" Value="{DynamicResource Accent}"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource AccentHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{DynamicResource TextFaint}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonOutline" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}"/>
    <Style x:Key="SecondaryButtonOutline" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}"/>
    <Style x:Key="TertiaryButtonOutline" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}"/>
    <Style x:Key="BorderlessButton" TargetType="Button" BasedOn="{StaticResource ButtonGhost}"/>

    <Style TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
        <Setter Property="behaviors:Hover.Opacity" Value="0.65"/>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor"
                Value="{DynamicResource Text}"/>
        <Setter Property="PlaceholderColor"
                Value="{DynamicResource TextFaint}"/>
        <Setter Property="Margin" Value="14,0"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style x:Key="Field" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource SurfaceRaisedBrush}"/>
        <Setter Property="Stroke"
                Value="{DynamicResource BorderControl}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=10}"/>
        <Setter Property="HeightRequest" Value="46"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}"/>
        <Setter Property="TextColor"
                Value="{DynamicResource Text}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>

    <Style TargetType="Picker" ApplyToDerivedTypes="True">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor"
                Value="{DynamicResource Text}"/>
        <Setter Property="TitleColor"
                Value="{DynamicResource TextFaint}"/>
        <Setter Property="BackgroundColor"
                Value="{DynamicResource SurfaceRaised}"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Accent}"/>
        <Setter Property="ThumbColor" Value="#FFFFFF"/>
        <Setter Property="behaviors:Hover.Cursor" Value="True"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Accent}"/>
        <Setter Property="MaximumTrackColor"
                Value="{DynamicResource BorderStrong}"/>
        <Setter Property="ThumbColor" Value="{DynamicResource Accent}"/>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Accent}"/>
    </Style>

    <Style TargetType="Image">
        <Setter Property="Aspect" Value="AspectFit"/>
    </Style>

    <Style TargetType="StackLayout">
        <Setter Property="Spacing" Value="10"/>
    </Style>

    <Style x:Key="LargeTitle" TargetType="Label" BasedOn="{StaticResource Display}"/>
    <Style x:Key="Headline" TargetType="Label" BasedOn="{StaticResource Overline}"/>
    <Style x:Key="Subtitle" TargetType="Label" BasedOn="{StaticResource Caption}"/>
    <Style x:Key="Subhead" TargetType="Label" BasedOn="{StaticResource Caption}"/>
    <Style x:Key="Footnote" TargetType="Label" BasedOn="{StaticResource Caption}"/>
    <Style x:Key="TypographyMeta" TargetType="Label" BasedOn="{StaticResource Caption}"/>
    <Style x:Key="PrimaryLabel" TargetType="Label" BasedOn="{StaticResource BrandText}"/>
    <Style x:Key="HRule" TargetType="BoxView" BasedOn="{StaticResource Divider}"/>
    <Style x:Key="DarkBorderView" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="LightBorderView" TargetType="Border" BasedOn="{StaticResource CardInset}"/>

</ResourceDictionary>
