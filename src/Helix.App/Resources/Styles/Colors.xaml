<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BrandAmber">#FFC212</Color>
    <Color x:Key="BrandGold">#F99419</Color>
    <Color x:Key="BrandOrange">#F77C1C</Color>
    <Color x:Key="Brand">#F14E23</Color>
    <Color x:Key="BrandDeep">#D33F1A</Color>
    <Color x:Key="BrandInk">#422520</Color>

    <Color x:Key="DangerSolid">#DC2626</Color>
    <Color x:Key="DangerSolidHover">#B91C1C</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>
    <Color x:Key="Black">#121110</Color>
    <Color x:Key="ScrimColor">#B3000000</Color>

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandAmber}" Offset="0.0"/>
        <GradientStop Color="{StaticResource BrandOrange}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Brand}" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
