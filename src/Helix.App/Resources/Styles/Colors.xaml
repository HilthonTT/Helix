<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BrandSoft">#FF4D67</Color>
    <Color x:Key="Brand">#F0193D</Color>
    <Color x:Key="BrandDeep">#9E1028</Color>
    <Color x:Key="BrandInk">#050505</Color>

    <Color x:Key="DangerSolid">#DC2626</Color>
    <Color x:Key="DangerSolidHover">#B91C1C</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>
    <Color x:Key="Black">#050505</Color>
    <Color x:Key="ScrimColor">#B3000000</Color>

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandDeep}" Offset="0.0"/>
        <GradientStop Color="#2A0910" Offset="0.5"/>
        <GradientStop Color="{StaticResource BrandInk}" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
