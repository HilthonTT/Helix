<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:controls="clr-namespace:Helix.App.Controls"
                    xmlns:behaviors="clr-namespace:Helix.App.Behaviors"
                    x:Class="Helix.App.Resources.Styles.ControlTemplates">

    <ControlTemplate x:Key="NavItemTemplate" x:DataType="controls:NavItem">
        <Grid Padding="10,3" behaviors:Hover.Cursor="True">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Pill"
                                        Property="Border.Background"
                                        Value="{DynamicResource AccentWashBrush}"/>
                                <Setter TargetName="Indicator" Property="Border.Opacity" Value="1"/>
                                <Setter TargetName="NavIcon" Property="Label.TextColor" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="NavLabel" Property="Label.TextColor" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="NavLabel" Property="Label.FontFamily" Value="{StaticResource FontSemibold}"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter TargetName="Pill" Property="Border.Background" Value="Transparent"/>
                                <Setter TargetName="Indicator" Property="Border.Opacity" Value="0"/>
                                <Setter TargetName="NavIcon"
                                        Property="Label.TextColor"
                                        Value="{DynamicResource TextMuted}"/>
                                <Setter TargetName="NavLabel"
                                        Property="Label.TextColor"
                                        Value="{DynamicResource TextMuted}"/>
                                <Setter TargetName="NavLabel" Property="Label.FontFamily" Value="{StaticResource FontRegular}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Pill"
                    Background="Transparent"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="{RoundRectangle CornerRadius=11}"
                    HeightRequest="44"
                    behaviors:Hover.Background="{DynamicResource SurfaceHover}"/>

            <Border x:Name="Indicator"
                    Background="{DynamicResource AccentBrush}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="{RoundRectangle CornerRadius=999}"
                    WidthRequest="3"
                    HeightRequest="20"
                    Opacity="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>

            <HorizontalStackLayout Spacing="12" Margin="16,0" VerticalOptions="Center" InputTransparent="True">
                <Label x:Name="NavIcon"
                       Text="{TemplateBinding Glyph}"
                       Style="{StaticResource Icon}"
                       FontSize="16"
                       WidthRequest="20"/>
                <Label x:Name="NavLabel"
                       Text="{TemplateBinding Content}"
                       FontSize="14"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="NavSectionTemplate" x:DataType="controls:NavItem">
        <Grid Padding="8,3" behaviors:Hover.Cursor="True">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Pill"
                                        Property="Border.Background"
                                        Value="{DynamicResource AccentWashBrush}"/>
                                <Setter TargetName="Pill" Property="Border.Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SectionIcon" Property="Label.TextColor" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="SectionTitle" Property="Label.TextColor" Value="{DynamicResource Accent}"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter TargetName="Pill" Property="Border.Background" Value="Transparent"/>
                                <Setter TargetName="Pill" Property="Border.Stroke" Value="Transparent"/>
                                <Setter TargetName="SectionIcon"
                                        Property="Label.TextColor"
                                        Value="{DynamicResource TextMuted}"/>
                                <Setter TargetName="SectionTitle"
                                        Property="Label.TextColor"
                                        Value="{DynamicResource Text}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Pill"
                    Background="Transparent"
                    Stroke="Transparent"
                    StrokeThickness="1"
                    StrokeShape="{RoundRectangle CornerRadius=12}"
                    behaviors:Hover.Background="{DynamicResource SurfaceHover}">

                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="2"
                      Padding="16,14"
                      InputTransparent="True">
                    <Label x:Name="SectionIcon"
                           Text="{TemplateBinding Glyph}"
                           Style="{StaticResource Icon}"
                           Grid.RowSpan="2"
                           FontSize="16"
                           WidthRequest="20"
                           VerticalOptions="Center"/>

                    <Label x:Name="SectionTitle"
                           Text="{TemplateBinding Content}"
                           Grid.Column="1"
                           FontFamily="{StaticResource FontSemibold}"
                           FontSize="14"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"/>

                    <Label Text="{TemplateBinding Description}"
                           Grid.Column="1"
                           Grid.Row="1"
                           Style="{StaticResource Caption}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"/>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SegmentTemplate" x:DataType="RadioButton">
        <Border x:Name="Segment"
                Stroke="{DynamicResource BorderControl}"
                StrokeThickness="1"
                StrokeShape="{RoundRectangle CornerRadius=999}"
                Background="Transparent"
                behaviors:Hover.Cursor="True">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SegmentLabel" Property="Label.TextColor" Value="#FFFFFF"/>
                                <Setter TargetName="SegmentLabel" Property="Label.FontFamily" Value="{StaticResource FontSemibold}"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Stroke"
                                        Value="{DynamicResource BorderControl}"/>
                                <Setter TargetName="SegmentLabel"
                                        Property="Label.TextColor"
                                        Value="{DynamicResource TextMuted}"/>
                                <Setter TargetName="SegmentLabel" Property="Label.FontFamily" Value="{StaticResource FontRegular}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>

            <Label x:Name="SegmentLabel"
                   Text="{TemplateBinding Content}"
                   Margin="18,9"
                   FontSize="13"
                   HorizontalTextAlignment="Center"/>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="ButtonRadioTemplate" x:DataType="RadioButton">
        <Border x:Name="Segment"
                Stroke="{DynamicResource BorderControl}"
                StrokeThickness="1"
                StrokeShape="{RoundRectangle CornerRadius=999}"
                Background="Transparent"
                behaviors:Hover.Cursor="True">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SegmentLabel" Property="Label.TextColor" Value="#FFFFFF"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter TargetName="SegmentLabel"
                                        Property="Label.TextColor"
                                        Value="{DynamicResource TextMuted}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>

            <Label x:Name="SegmentLabel" Text="{TemplateBinding Content}" Margin="18,9" FontSize="13"/>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="OptionTemplate" x:DataType="x:String">
        <Border Background="{DynamicResource SurfaceAltBrush}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1"
                StrokeShape="{RoundRectangle CornerRadius=10}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter Property="Stroke"
                                        Value="{DynamicResource BorderBrush}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>

            <ContentPresenter/>
        </Border>
    </ControlTemplate>

</ResourceDictionary>
