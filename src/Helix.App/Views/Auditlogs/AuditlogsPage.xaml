<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Helix.App.Models"
             xmlns:icons="clr-namespace:Helix.App.Icons"
             xmlns:vm="clr-namespace:Helix.App.ViewModels.Auditlogs"
             xmlns:views="clr-namespace:Helix.App.Views.Auditlogs"
             xmlns:l10n="clr-namespace:Helix.App.Localization"
             xmlns:behaviors="clr-namespace:Helix.App.Behaviors"
             xmlns:controls="clr-namespace:Helix.App.Controls"
             x:Class="Helix.App.Views.Auditlogs.AuditlogsPage"
             x:DataType="vm:AuditlogsViewModel"
             Title="">

    <Grid>

        <Grid RowDefinitions="Auto,*" RowSpacing="20" Padding="28,24">

            <VerticalStackLayout Spacing="2">
                <Label Text="{l10n:Translate Auditlogs}" Style="{StaticResource Display}"/>
                <Label Style="{StaticResource Muted}"
                       Text="{Binding Source={x:Static l10n:LocalizationResourceManager.Instance}, Path=CurrentDate, x:DataType=l10n:LocalizationResourceManager}"/>
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,Auto,*" Padding="20">

                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="0,0,0,16">
                        <Label Text="{l10n:Translate YourAuditlogs}"
                               Style="{StaticResource Title1}"
                               VerticalOptions="Center"/>

                        <Border Grid.Column="1" Style="{StaticResource PillNeutral}" Padding="9,3">
                            <Label Text="{Binding Auditlogs.Count}"
                                   Style="{StaticResource Caption}"
                                   FontFamily="{StaticResource FontMonoBold}"/>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Field}"
                                MaximumWidthRequest="300"
                                HorizontalOptions="End"
                                Margin="0,0,4,0"
                                VerticalOptions="Center">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Text="{x:Static icons:IconFont.Search}"
                                       Style="{StaticResource IconSm}"
                                       Margin="12,0,0,0"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}"/>

                                <Entry Grid.Column="1"
                                       Margin="8,0,10,0"
                                       Placeholder="{l10n:Translate SearchAuditlogs}"
                                       Text="{Binding SearchTerm}"/>

                                <Border Grid.Column="2"
                                        Style="{StaticResource IconHit}"
                                        Margin="0,0,8,0"
                                        IsVisible="{Binding HasSearchTerm}"
                                        ToolTipProperties.Text="{l10n:Translate ClearSearch}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ClearSearchCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{x:Static icons:IconFont.Times}"
                                           Style="{StaticResource IconSm}"
                                           FontSize="12"
                                           InputTransparent="True"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="10"
                                         IsVisible="{Binding Auditlogs.Count, Converter={StaticResource CountToBoolConverter}}">
                        <Grid ColumnDefinitions="Auto,*,200" ColumnSpacing="14" Padding="12,0">
                            <Label Text=" " Style="{StaticResource Overline}" WidthRequest="7"/>
                            <Label Grid.Column="1" Text="{l10n:Translate Message}" Style="{StaticResource Overline}"/>
                            <HorizontalStackLayout Grid.Column="2"
                                                   Spacing="5"
                                                   HorizontalOptions="End"
                                                   behaviors:Hover.Cursor="True">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleSortOrderCommand}"/>
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="{l10n:Translate Date}" Style="{StaticResource Overline}"/>
                                <Label Text="{Binding SortGlyph}"
                                       Style="{StaticResource Overline}"
                                       FontFamily="{StaticResource FontIcon}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource Divider}"/>
                    </VerticalStackLayout>

                    <CollectionView Grid.Row="2"
                                    Margin="0,8,0,0"
                                    ItemsSource="{Binding Auditlogs}"
                                    SelectionMode="None"
                                    IsVisible="{Binding Auditlogs.Count, Converter={StaticResource CountToBoolConverter}}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="2"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:AuditlogDisplay">
                                <views:AuditlogTemplate/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout Grid.Row="1"
                                         Grid.RowSpan="2"
                                         Spacing="10"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         IsVisible="{Binding ShowNoMatches}">
                        <Border Style="{StaticResource IconTile}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Center">
                            <Label Text="{x:Static icons:IconFont.Search}"
                                   Style="{StaticResource IconLg}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                        </Border>

                        <Label Text="{l10n:Translate NoAuditlogsMatchTitle}"
                               Style="{StaticResource Title2}"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="{l10n:Translate NoAuditlogsMatchMessage}"
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="360"/>

                        <Button Text="{l10n:Translate ClearSearch}"
                                Style="{StaticResource ButtonSecondary}"
                                Margin="0,6,0,0"
                                HorizontalOptions="Center"
                                Command="{Binding ClearSearchCommand}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1"
                                         Grid.RowSpan="2"
                                         Spacing="10"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         IsVisible="{Binding ShowNoAuditlogs}">
                        <Border Style="{StaticResource IconTile}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Center">
                            <Label Text="{x:Static icons:IconFont.History}"
                                   Style="{StaticResource IconLg}"
                                   TextColor="{StaticResource Brand}"/>
                        </Border>

                        <Label Text="{l10n:Translate NoAuditlogsTitle}"
                               Style="{StaticResource Title2}"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="{l10n:Translate NoAuditlogsMessage}"
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="360"/>
                    </VerticalStackLayout>

                </Grid>
            </Border>
        </Grid>

        <controls:NotificationHost/>

    </Grid>

</ContentPage>
