<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=netstandard"
             xmlns:vm="clr-namespace:Helix.App.ViewModels.Settings"
             xmlns:controls="clr-namespace:Helix.App.Controls"
             xmlns:icons="clr-namespace:Helix.App.Icons"
             xmlns:users="clr-namespace:Helix.App.Views.Users"
             xmlns:l10n="clr-namespace:Helix.App.Localization"
             x:Class="Helix.App.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="">

    <ContentPage.Resources>
        <Style x:Key="PreferenceRow" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="*,Auto"/>
            <Setter Property="ColumnSpacing" Value="24"/>
        </Style>
    </ContentPage.Resources>

    <Grid>

        <Grid RowDefinitions="Auto,*"
              ColumnDefinitions="300,*"
              ColumnSpacing="20"
              RowSpacing="20"
              Padding="28,24">

            <VerticalStackLayout Grid.ColumnSpan="2" Spacing="2">
                <Label Text="{l10n:Translate Settings}" Style="{StaticResource Display}"/>
                <Label Style="{StaticResource Muted}"
                       Text="{Binding Source={x:Static l10n:LocalizationResourceManager.Instance}, Path=CurrentDate, x:DataType=l10n:LocalizationResourceManager}"/>
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource Card}" VerticalOptions="Start">
                <VerticalStackLayout Padding="8,10"
                                     Spacing="2"
                                     RadioButtonGroup.GroupName="Sections"
                                     RadioButtonGroup.SelectedValue="{Binding CurrentSection, Mode=TwoWay}">
                    <VerticalStackLayout.Resources>
                        <Style TargetType="controls:NavItem">
                            <Setter Property="ControlTemplate" Value="{StaticResource NavSectionTemplate}"/>
                        </Style>
                    </VerticalStackLayout.Resources>

                    <controls:NavItem Value="account"
                                      Glyph="{x:Static icons:IconFont.UserCircle}"
                                      Content="{l10n:Translate AccountInformation}"
                                      Description="{l10n:Translate ChangeYourAccountInfo}"
                                      IsChecked="True"/>

                    <controls:NavItem Value="settings"
                                      Glyph="{x:Static icons:IconFont.SlidersH}"
                                      Content="{l10n:Translate Preferences}"
                                      Description="{l10n:Translate ManageYourPreferences}"/>
                </VerticalStackLayout>
            </Border>

            <ScrollView Grid.Row="1" Grid.Column="1">
                <Grid>
                    <Border Style="{StaticResource Card}" VerticalOptions="Start" IsVisible="False">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentSection}" Value="account">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentSection}" Value="{x:Static system:String.Empty}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Padding="24" Spacing="18">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{l10n:Translate AccountInformation}" Style="{StaticResource Title1}"/>
                                <Label Text="{l10n:Translate ChangeYourAccountInfo}" Style="{StaticResource Caption}"/>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource Divider}"/>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate UsernameField}" Style="{StaticResource Caption}"/>
                                    <Label Text="{Binding Username}" Style="{StaticResource Title2}"/>
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        Style="{StaticResource IconChip}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        ToolTipProperties.Text="{l10n:Translate UpdateYourUsername}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding EditUsernameCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{x:Static icons:IconFont.PencilAlt}"
                                           Style="{StaticResource IconSm}"
                                           InputTransparent="True"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                                </Border>
                            </Grid>

                            <BoxView Style="{StaticResource Divider}"/>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate PasswordField}" Style="{StaticResource Caption}"/>
                                    <Label Text="••••••••" Style="{StaticResource Title2}"/>
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        Style="{StaticResource IconChip}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        ToolTipProperties.Text="{l10n:Translate UpdatePassword}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding EditPasswordCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{x:Static icons:IconFont.PencilAlt}"
                                           Style="{StaticResource IconSm}"
                                           InputTransparent="True"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" VerticalOptions="Start" IsVisible="False">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentSection}" Value="settings">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentSection}" Value="{x:Static system:String.Empty}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Padding="24" Spacing="18">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{l10n:Translate Preferences}" Style="{StaticResource Title1}"/>
                                <Label Text="{l10n:Translate ManageYourPreferences}" Style="{StaticResource Caption}"/>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource Divider}"/>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate AutoConnectDrivesOnLaunch}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate AutoConnectDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding Settings.AutoConnect}"
                                        IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate AutoMinimizeApp}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate AutoMinimizeDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding Settings.AutoMinimize}"
                                        IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}" IsVisible="{Binding SupportsTray}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate CloseToTray}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate CloseToTrayDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding Settings.CloseToTray}"
                                        IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}" IsVisible="{Binding SupportsTray}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate NotifyOnMinimizeToTray}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate NotifyOnMinimizeToTrayDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding Settings.NotifyOnMinimizeToTray}"
                                        IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate SetOnStartup}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate SetOnStartupDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding Settings.SetOnStartup}"
                                        IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate SetDesktopShortcut}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate SetDesktopShortcutDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding Settings.SetDesktopShortcut}"
                                        IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <BoxView Style="{StaticResource Divider}"/>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate Languages}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate LanguageDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource Field}" WidthRequest="200" VerticalOptions="Center">
                                    <Picker Margin="8,0"
                                            BackgroundColor="Transparent"
                                            IsEnabled="{Binding Settings.IsNotBusy}"
                                            ItemsSource="{Binding Languages}"
                                            SelectedItem="{Binding SelectedLanguage}"/>
                                </Border>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate TimerCountInSeconds}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate TimerCountDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <controls:NumberField Grid.Column="1"
                                                      WidthRequest="200"
                                                      VerticalOptions="Center"
                                                      Value="{Binding Settings.TimerCount}"
                                                      Minimum="1"
                                                      Maximum="3600"
                                                      Step="1"
                                                      Unit="{l10n:Translate UnitSeconds}"
                                                      IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate AuditlogRetention}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate AuditlogRetentionDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <controls:NumberField Grid.Column="1"
                                                      WidthRequest="200"
                                                      VerticalOptions="Center"
                                                      Value="{Binding Settings.AuditlogRetentionDays}"
                                                      Minimum="0"
                                                      Maximum="3650"
                                                      Step="10"
                                                      Unit="{l10n:Translate UnitDays}"
                                                      OffText="{l10n:Translate RetentionKeepEverything}"
                                                      IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate StorageAlertThreshold}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate StorageAlertThresholdDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <controls:NumberField Grid.Column="1"
                                                      WidthRequest="200"
                                                      VerticalOptions="Center"
                                                      Value="{Binding Settings.StorageAlertThresholdPercent}"
                                                      Minimum="0"
                                                      Maximum="{Binding MaximumStorageAlertThresholdPercent}"
                                                      Step="1"
                                                      Unit="{l10n:Translate UnitPercent}"
                                                      OffText="{l10n:Translate StorageAlertOff}"
                                                      IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate IdleLock}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate IdleLockDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <controls:NumberField Grid.Column="1"
                                                      WidthRequest="200"
                                                      VerticalOptions="Center"
                                                      Value="{Binding Settings.IdleLockMinutes}"
                                                      Minimum="0"
                                                      Maximum="1440"
                                                      Step="5"
                                                      Unit="{l10n:Translate UnitMinutes}"
                                                      OffText="{l10n:Translate IdleLockNever}"
                                                      IsEnabled="{Binding Settings.IsNotBusy}"/>
                            </Grid>

                            <BoxView Style="{StaticResource Divider}"/>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate ExportDiagnostics}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate ExportDiagnosticsDescription}" Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ButtonSecondary}"
                                        WidthRequest="200"
                                        VerticalOptions="Center"
                                        Text="{l10n:Translate Export}"
                                        Command="{Binding ExportDiagnosticsCommand}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                            </Grid>

                            <Grid Style="{StaticResource PreferenceRow}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{l10n:Translate Updates}" Style="{StaticResource Title3}"/>
                                    <Label Text="{l10n:Translate UpdatesDescription}" Style="{StaticResource Caption}"/>

                                    <Label Text="{Binding UpdateStatus}"
                                           Style="{StaticResource Caption}"
                                           FontFamily="{StaticResource FontMono}"
                                           IsVisible="{Binding HasUpdateStatus}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ButtonSecondary}"
                                        WidthRequest="200"
                                        VerticalOptions="Center"
                                        Text="{l10n:Translate CheckForUpdates}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ScrollView>

        </Grid>

        <BoxView x:Name="BlockScreen"
                 Color="{StaticResource Black}"
                 Opacity="0"
                 InputTransparent="True"/>

        <AbsoluteLayout x:Name="UpdateUsernameLayout" IsVisible="False">
            <users:UpdateUsernameModal x:Name="UpdateUsernameView"
                                               WidthRequest="440"
                                               AbsoluteLayout.LayoutBounds="0.5,0.5,-1,-1"
                                               AbsoluteLayout.LayoutFlags="PositionProportional"/>
        </AbsoluteLayout>

        <AbsoluteLayout x:Name="UpdatePasswordLayout" IsVisible="False">
            <users:UpdatePasswordModal x:Name="UpdatePasswordView"
                                                WidthRequest="460"
                                                MaximumHeightRequest="560"
                                                AbsoluteLayout.LayoutBounds="0.5,0.5,-1,-1"
                                                AbsoluteLayout.LayoutFlags="PositionProportional"/>
        </AbsoluteLayout>

        <controls:NotificationHost/>

    </Grid>

</ContentPage>
