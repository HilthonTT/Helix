<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Helix.App.ViewModels.Drives"
             xmlns:models="clr-namespace:Helix.App.Models"
             xmlns:icons="clr-namespace:Helix.App.Icons"
             xmlns:l10n="clr-namespace:Helix.App.Localization"
             x:DataType="vm:CreateDriveViewModel"
             x:Class="Helix.App.Views.Drives.CreateDriveModal"
             BackgroundColor="Transparent">

    <Border Style="{StaticResource Sheet}">
        <Grid RowDefinitions="Auto,*,Auto">

            <Grid ColumnDefinitions="*,Auto" Padding="24,20,20,16">
                <Label Text="{l10n:Translate AddDrive}"
                       Style="{StaticResource Title1}"
                       VerticalOptions="Center"/>

                <Border Grid.Column="1"
                        Style="{StaticResource IconChip}"
                        VerticalOptions="Start"
                        ToolTipProperties.Text="{l10n:Translate Close}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static icons:IconFont.Times}"
                           Style="{StaticResource IconSm}"
                           InputTransparent="True"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                </Border>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="14" Padding="24,4,24,20">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{l10n:Translate Letter}" Style="{StaticResource FieldLabel}"/>

                        <Border Style="{StaticResource Field}">
                            <Picker Margin="8,0"
                                    BackgroundColor="Transparent"
                                    ItemsSource="{Binding AvailableLetters}"
                                    SelectedItem="{Binding Form.Letter}"
                                    IsEnabled="{Binding IsNotBusy}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{l10n:Translate DriveName}" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}" IsVisible="{Binding IsSingleShare}">
                            <Entry Placeholder="{l10n:Translate AddDriveNamePlaceholder}"
                                   Text="{Binding Form.Name}"
                                   IsEnabled="{Binding IsNotBusy}"/>
                        </Border>
                        <Label Text="{Binding SharesSelectedText}"
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding IsMultiShare}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{l10n:Translate NasHost}" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <Entry Placeholder="{l10n:Translate AddNasHostPlaceholder}"
                                   Text="{Binding Form.Host}"
                                   IsEnabled="{Binding IsNotBusy}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{l10n:Translate NasUsername}" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <Entry Placeholder="{l10n:Translate AddNasUsernamePlaceholder}"
                                   Text="{Binding Form.Username}"
                                   IsPassword="{Binding HideSecrets}"
                                   IsEnabled="{Binding IsNotBusy}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{l10n:Translate NasPassword}" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <Entry Placeholder="{l10n:Translate AddNasPasswordPlaceholder}"
                                   Text="{Binding Form.Password}"
                                   IsPassword="{Binding HideSecrets}"
                                   IsEnabled="{Binding IsNotBusy}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding SupportsShareBrowsing}">
                        <Button Style="{StaticResource ButtonSecondary}"
                                HorizontalOptions="Start"
                                Text="{l10n:Translate BrowseShares}"
                                Command="{Binding BrowseSharesCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>

                        <VerticalStackLayout Spacing="2"
                                             IsVisible="{Binding HasShares}"
                                             BindableLayout.ItemsSource="{Binding Shares}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ShareOption">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,2">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding Label}"
                                               Style="{StaticResource Caption}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="{l10n:Translate NoSharesFound}"
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding ShowNoShares}"/>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <Label Text="{l10n:Translate ShowCredentials}"
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                Scale="0.85"
                                HorizontalOptions="End"
                                IsToggled="{Binding HideSecrets, Converter={StaticResource InvertedBoolConverter}, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <Label Text="{l10n:Translate AutoConnectDrive}"
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                Scale="0.85"
                                HorizontalOptions="End"
                                IsToggled="{Binding Form.AutoConnect, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,2,0,0"
                          IsVisible="{Binding SupportsPersistentMappings}">
                        <Label Text="{l10n:Translate PersistentMapping}"
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                Scale="0.85"
                                HorizontalOptions="End"
                                IsToggled="{Binding Form.Persistent, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,2,0,0"
                          IsVisible="{Binding NetworkPin.IsSupported}">
                        <Label Text="{Binding NetworkPin.Label}"
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                Scale="0.85"
                                HorizontalOptions="End"
                                IsEnabled="{Binding NetworkPin.CanChange}"
                                IsToggled="{Binding NetworkPin.IsPinned, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,2,0,0"
                          IsVisible="{Binding SupportsHostnameConnect}">
                        <Label Text="{l10n:Translate ConnectByHostname}"
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                Scale="0.85"
                                HorizontalOptions="End"
                                IsToggled="{Binding Form.ConnectByHostname, Mode=TwoWay}"/>
                    </Grid>

                    <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                        <Label Text="{l10n:Translate RemoteHost}" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <Entry Placeholder="{l10n:Translate RemoteHostPlaceholder}"
                                   Text="{Binding Form.RemoteHost}"
                                   IsEnabled="{Binding IsNotBusy}"/>
                        </Border>
                        <Label Text="{l10n:Translate RemoteHostDescription}" Style="{StaticResource Caption}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                        <Label Text="{l10n:Translate WakeMacAddress}" Style="{StaticResource FieldLabel}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Style="{StaticResource Field}">
                                <Entry Placeholder="{l10n:Translate WakeMacAddressPlaceholder}"
                                       Text="{Binding Form.MacAddress}"
                                       IsEnabled="{Binding IsNotBusy}"/>
                            </Border>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ButtonSecondary}"
                                    Text="{l10n:Translate LookUpMacAddress}"
                                    Command="{Binding LookUpMacAddressCommand}"
                                    IsVisible="{Binding SupportsMacLookUp}"
                                    IsEnabled="{Binding IsNotBusy}"/>
                        </Grid>
                        <Label Text="{l10n:Translate WakeMacAddressDescription}" Style="{StaticResource Caption}"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Padding="24,16,24,24">
                <Button Style="{StaticResource ButtonSecondary}"
                        HorizontalOptions="Fill"
                        Text="{l10n:Translate Cancel}"
                        Command="{Binding CloseCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>

                <Button Grid.Column="1"
                        Style="{StaticResource ButtonSecondary}"
                        HorizontalOptions="Fill"
                        Text="{l10n:Translate TestConnection}"
                        Command="{Binding TestConnectionCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>

                <Button Grid.Column="2"
                        HorizontalOptions="Fill"
                        Text="{l10n:Translate Save}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
            </Grid>
        </Grid>
    </Border>

</ContentView>
