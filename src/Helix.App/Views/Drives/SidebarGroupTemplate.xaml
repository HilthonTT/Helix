<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Helix.App.Models"
             xmlns:icons="clr-namespace:Helix.App.Icons"
             xmlns:behaviors="clr-namespace:Helix.App.Behaviors"
             xmlns:l10n="clr-namespace:Helix.App.Localization"
             x:Class="Helix.App.Views.Drives.SidebarGroupTemplate"
             x:DataType="models:DriveGroupDisplay">

    <Grid ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="2"
          Padding="26,5,16,5"
          IsEnabled="{Binding IsNotBusy}">

        <Label Text="{Binding Name}"
               Style="{StaticResource Muted}"
               VerticalOptions="Center"
               LineBreakMode="TailTruncation"
               MaxLines="1"
               ToolTipProperties.Text="{Binding MemberCountText}"/>

        <Border Grid.Column="1"
                Style="{StaticResource IconHit}"
                behaviors:Hover.Cursor="True"
                ToolTipProperties.Text="{l10n:Translate ConnectGroup}"
                SemanticProperties.Description="{l10n:Translate ConnectGroup}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Connect"/>
            </Border.GestureRecognizers>
            <Label Text="{x:Static icons:IconFont.Link}"
                   Style="{StaticResource IconSm}"
                   FontSize="12"
                   InputTransparent="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}"/>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource IconHit}"
                behaviors:Hover.Cursor="True"
                ToolTipProperties.Text="{l10n:Translate DisconnectGroup}"
                SemanticProperties.Description="{l10n:Translate DisconnectGroup}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Disconnect"/>
            </Border.GestureRecognizers>
            <Label Text="{x:Static icons:IconFont.Unlink}"
                   Style="{StaticResource IconSm}"
                   FontSize="12"
                   InputTransparent="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"/>
        </Border>

    </Grid>

</ContentView>
