<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Helix.App.Models"
             xmlns:icons="clr-namespace:Helix.App.Icons"
             xmlns:behaviors="clr-namespace:Helix.App.Behaviors"
             xmlns:l10n="clr-namespace:Helix.App.Localization"
             x:Class="Helix.App.Views.Drives.DriveTemplate"
             x:DataType="models:DriveDisplay">

    <Border Style="{StaticResource Row}" IsEnabled="{Binding IsNotBusy}">
        <Grid ColumnDefinitions="72,*,190,160,Auto" ColumnSpacing="14">

            <!-- Drive letter, monospaced so the column stays optically aligned -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardInset}"
                    Padding="10,6"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                <Label Text="{Binding Letter}"
                       Style="{StaticResource Mono}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"/>
            </Border>

            <!--
            Name over last-connected: "offline" alone says nothing about whether the
            share dropped a minute ago or has never been reachable.
            -->
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="{Binding Name}"
                       Style="{StaticResource BodyStrong}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>

                <Label Text="{Binding LastConnected}"
                       Style="{StaticResource Caption}"
                       FontSize="11"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>
            </VerticalStackLayout>

            <Label Grid.Column="2"
                   Text="{Binding StorageUsage}"
                   Style="{StaticResource Caption}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"/>

            <!--
            The status is the toggle. Pills swap rather than one pill retinted by a
            trigger, so the resting colours stay plain style values and the hover
            animation has a stable colour to return to.

            Three of them are ways of being offline, because "Disconnected" alone covered
            a drive the user put down, a NAS that is on another network, and a share that
            refused the password — and away from the NAS that is every row on the page,
            all day, in the same red.

            The busy one replaces all the others while a mount is in flight: the row is
            disabled for the duration, so leaving the old pill up left the user pressing
            "Disconnected" with nothing appearing to happen for as long as the share took
            to answer.
            -->
            <Grid Grid.Column="3" VerticalOptions="Center">
                <Border Style="{StaticResource PillSuccess}"
                        IsVisible="{Binding ShowConnected}"
                        ToolTipProperties.Text="{l10n:Translate Disconnect}"
                        behaviors:Hover.Cursor="True"
                        behaviors:Hover.Scale="1.04">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ToggleConnect"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" InputTransparent="True">
                        <Label Text="{x:Static icons:IconFont.Circle}"
                               Style="{StaticResource IconSm}"
                               FontSize="8"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}"/>
                        <Label Text="{l10n:Translate Connected}"
                               Style="{StaticResource SuccessText}"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border Style="{StaticResource PillDanger}"
                        IsVisible="{Binding ShowDisconnected}"
                        ToolTipProperties.Text="{l10n:Translate Connect}"
                        behaviors:Hover.Cursor="True"
                        behaviors:Hover.Scale="1.04">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ToggleConnect"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" InputTransparent="True">
                        <Label Text="{x:Static icons:IconFont.Circle}"
                               Style="{StaticResource IconSm}"
                               FontSize="8"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"/>
                        <Label Text="{l10n:Translate Disconnected}"
                               Style="{StaticResource DangerText}"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!--
                Offline, but the NAS never answered — the ordinary state of a laptop away
                from it, so amber rather than red, and it says what it is instead of
                sharing a word with a wrong password. Tappable like the others: pressing
                it is a deliberate attempt, which is worth making even when the last
                unattended one found nothing.
                -->
                <Border Style="{StaticResource PillWarning}"
                        IsVisible="{Binding ShowUnreachable}"
                        ToolTipProperties.Text="{Binding OfflineDetail}"
                        behaviors:Hover.Cursor="True"
                        behaviors:Hover.Scale="1.04">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ToggleConnect"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" InputTransparent="True">
                        <Label Text="{x:Static icons:IconFont.Circle}"
                               Style="{StaticResource IconSm}"
                               FontSize="8"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"/>
                        <Label Text="{l10n:Translate StatusUnreachable}"
                               Style="{StaticResource WarningText}"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- The NAS answered and the mount was refused: a real failure, and the
                     tooltip carries what it said. -->
                <Border Style="{StaticResource PillDanger}"
                        IsVisible="{Binding ShowFailed}"
                        ToolTipProperties.Text="{Binding OfflineDetail}"
                        behaviors:Hover.Cursor="True"
                        behaviors:Hover.Scale="1.04">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ToggleConnect"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" InputTransparent="True">
                        <Label Text="{x:Static icons:IconFont.ExclamationCircle}"
                               Style="{StaticResource IconSm}"
                               FontSize="9"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"/>
                        <Label Text="{l10n:Translate StatusFailed}"
                               Style="{StaticResource DangerText}"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border Style="{StaticResource PillNeutral}"
                        IsVisible="{Binding IsBusy}">
                    <HorizontalStackLayout Spacing="8" InputTransparent="True">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           WidthRequest="12"
                                           HeightRequest="12"
                                           VerticalOptions="Center"/>
                        <Label Text="{Binding BusyText}"
                               Style="{StaticResource Caption}"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Row actions -->
            <HorizontalStackLayout Grid.Column="4" Spacing="8" VerticalOptions="Center">
                <Border Style="{StaticResource IconChip}"
                        ToolTipProperties.Text="{l10n:Translate UpdateDrive}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="HandleUpdate"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static icons:IconFont.PencilAlt}"
                           Style="{StaticResource IconSm}"
                           InputTransparent="True"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                </Border>

                <Border Style="{StaticResource IconChip}"
                        ToolTipProperties.Text="{l10n:Translate DeleteDrive}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="HandleDelete"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static icons:IconFont.Trash}"
                           Style="{StaticResource IconSm}"
                           InputTransparent="True"
                           TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"/>
                </Border>
            </HorizontalStackLayout>

        </Grid>
    </Border>
</ContentView>
