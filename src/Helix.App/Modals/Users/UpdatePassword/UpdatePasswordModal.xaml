<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modals="clr-namespace:Helix.App.Modals.Users.UpdatePassword"
             xmlns:icons="clr-namespace:Helix.App.Icons"
             xmlns:local="clr-namespace:Helix.App"
             x:Class="Helix.App.Modals.Users.UpdatePassword.UpdatePasswordModal"
             x:DataType="modals:UpdatePasswordViewModel"
             BackgroundColor="Transparent">

    <Border Style="{StaticResource Sheet}">
        <Grid RowDefinitions="Auto,*,Auto">

            <Grid ColumnDefinitions="*,Auto" Padding="24,20,20,16">
                <Label Text="{local:Translate UpdatePassword}"
                       Style="{StaticResource Title1}"
                       VerticalOptions="Center"/>

                <Border Grid.Column="1"
                        Style="{StaticResource IconChip}"
                        VerticalOptions="Start"
                        ToolTipProperties.Text="{local:Translate Close}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static icons:IconFont.Times}"
                           Style="{StaticResource IconSm}"
                           InputTransparent="True"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                </Border>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="14" Padding="24,4,24,20">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{local:Translate YourCurrentPassword}" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <Entry Placeholder="{local:Translate AddCurrentPasswordPlaceholder}"
                                   IsPassword="True"
                                   Text="{Binding CurrentPassword}"
                                   IsEnabled="{Binding IsNotBusy}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{local:Translate YourNewPassword}" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <Entry Placeholder="{local:Translate AddNewPasswordPlaceholder}"
                                   IsPassword="True"
                                   Text="{Binding NewPassword}"
                                   IsEnabled="{Binding IsNotBusy}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{local:Translate ConfirmNewPassword}" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <Entry Placeholder="{local:Translate AddConfirmNewPasswordPlaceholder}"
                                   IsPassword="True"
                                   Text="{Binding ConfirmedNewPassword}"
                                   IsEnabled="{Binding IsNotBusy}"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="24,4,24,24">
                <Button Style="{StaticResource ButtonSecondary}"
                        HorizontalOptions="Fill"
                        Text="{local:Translate Cancel}"
                        Command="{Binding CloseCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>

                <Button Grid.Column="1"
                        HorizontalOptions="Fill"
                        Text="{local:Translate Save}"
                        Command="{Binding UpdatePasswordCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
            </Grid>
        </Grid>
    </Border>

</ContentView>
