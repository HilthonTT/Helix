<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Helix.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:register="clr-namespace:Helix.App.Views.Users"
    xmlns:login="clr-namespace:Helix.App.Views.Users"
    xmlns:home="clr-namespace:Helix.App.Views.Drives"
    xmlns:settings="clr-namespace:Helix.App.Views.Settings"
    xmlns:auditlogs="clr-namespace:Helix.App.Views.Auditlogs"
    xmlns:behaviors="clr-namespace:Helix.App.Behaviors"
    xmlns:controls="clr-namespace:Helix.App.Controls"
    xmlns:icons="clr-namespace:Helix.App.Icons"
    xmlns:models="clr-namespace:Helix.App.Models"
    xmlns:local="clr-namespace:Helix.App"
    xmlns:l10n="clr-namespace:Helix.App.Localization"
    Shell.FlyoutBehavior="Disabled"
    Shell.FlyoutWidth="236">

    <Shell.FlyoutContentTemplate>
        <DataTemplate x:DataType="local:AppShell">

            <Grid ColumnDefinitions="*,1"
                  Background="{AppThemeBinding Light={StaticResource SurfaceLightBrush}, Dark={StaticResource SurfaceDarkBrush}}">

                <BoxView Grid.Column="1"
                         Style="{StaticResource Divider}"
                         WidthRequest="1"
                         HeightRequest="-1"
                         VerticalOptions="Fill"/>

                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                      RadioButtonGroup.GroupName="Menu"
                      RadioButtonGroup.SelectedValue="{Binding SelectedRoute}">

                    <HorizontalStackLayout Grid.Row="0" Spacing="12" Margin="26,28,20,26">
                        <Image Source="logoipsum.png"
                               Aspect="AspectFit"
                               WidthRequest="24"
                               HeightRequest="31"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="Helix"
                                   FontFamily="{StaticResource FontSemibold}"
                                   FontSize="17"
                                   CharacterSpacing="0.4"/>
                            <Label Text="{l10n:Translate NasManager}" Style="{StaticResource Faint}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Spacing="2">
                        <VerticalStackLayout.Resources>
                            <Style TargetType="controls:NavItem">
                                <Setter Property="ControlTemplate" Value="{StaticResource NavItemTemplate}"/>
                            </Style>
                        </VerticalStackLayout.Resources>

                        <Label Text="{l10n:Translate Menu}"
                               Style="{StaticResource Overline}"
                               Margin="26,0,0,8"/>

                        <controls:NavItem Value="dashboard"
                                          Glyph="{x:Static icons:IconFont.ThLarge}"
                                          Content="{l10n:Translate Dashboard}"
                                          CheckedChanged="OnMenuItemChanged"/>

                        <controls:NavItem Value="auditlogs"
                                          Glyph="{x:Static icons:IconFont.History}"
                                          Content="{l10n:Translate Auditlogs}"
                                          CheckedChanged="OnMenuItemChanged"/>

                        <controls:NavItem Value="settings"
                                          Glyph="{x:Static icons:IconFont.Cog}"
                                          Content="{l10n:Translate Settings}"
                                          CheckedChanged="OnMenuItemChanged"/>
                    </VerticalStackLayout>

                    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" Margin="0,18,0,0">

                        <Label Grid.Row="0"
                               Text="{l10n:Translate DriveGroups}"
                               Style="{StaticResource Overline}"
                               Margin="26,0,0,6"
                               IsVisible="{Binding HasGroups}"/>

                        <ScrollView Grid.Row="1"
                                    VerticalScrollBarVisibility="Never"
                                    IsVisible="{Binding HasGroups}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:DriveGroupDisplay">
                                        <home:SidebarGroupTemplate BindingContext="{Binding .}"/>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>

                        <VerticalStackLayout Grid.Row="2" Spacing="7" Margin="0,16,0,12">

                            <Label Text="{l10n:Translate Overview}"
                                   Style="{StaticResource Overline}"
                                   Margin="26,0,0,2"
                                   IsVisible="{Binding Estate.HasDrives}"/>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10"
                                  Margin="26,0,20,0"
                                  IsVisible="{Binding Estate.HasDrives}">
                                <Label Text="{x:Static icons:IconFont.Plug}"
                                       Style="{StaticResource IconSm}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}"/>
                                <Label Grid.Column="1"
                                       Text="{l10n:Translate Connected}"
                                       Style="{StaticResource Faint}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="2"
                                       Text="{Binding Estate.ConnectedSummary}"
                                       Style="{StaticResource Mono}"
                                       FontSize="12"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10"
                                  Margin="26,0,20,0"
                                  IsVisible="{Binding Estate.HasDrives}">
                                <Label Text="{x:Static icons:IconFont.Hdd}"
                                       Style="{StaticResource IconSm}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}"/>
                                <Label Grid.Column="1"
                                       Text="{l10n:Translate Storage}"
                                       Style="{StaticResource Faint}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="2"
                                       Text="{Binding Estate.StorageSummary}"
                                       Style="{StaticResource Mono}"
                                       FontSize="12"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <Border Margin="16,4,16,0"
                                    Padding="12,9"
                                    Style="{StaticResource Pill}"
                                    StrokeShape="{RoundRectangle CornerRadius=11}"
                                    Background="{AppThemeBinding Light={StaticResource WarningWashLightBrush}, Dark={StaticResource WarningWashDarkBrush}}"
                                    IsVisible="{Binding Estate.HasLowSpace}">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{x:Static icons:IconFont.ExclamationTriangle}"
                                           Style="{StaticResource IconSm}"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"/>
                                    <Label Text="{l10n:Translate TrayStorageLow}"
                                           Style="{StaticResource Caption}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"/>
                                </HorizontalStackLayout>
                            </Border>

                            <Border Margin="16,4,16,0"
                                    Padding="12,9"
                                    Style="{StaticResource Pill}"
                                    StrokeShape="{RoundRectangle CornerRadius=11}"
                                    Background="{AppThemeBinding Light={StaticResource BrandWashLightBrush}, Dark={StaticResource BrandWashDarkBrush}}"
                                    behaviors:Hover.Cursor="True"
                                    ToolTipProperties.Text="{l10n:Translate CheckForUpdates}"
                                    IsVisible="{Binding UpdateAvailable}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShowUpdates"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" InputTransparent="True">
                                    <Label Text="{x:Static icons:IconFont.CloudDownloadAlt}"
                                           Style="{StaticResource IconSm}"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Brand}"/>
                                    <Label Grid.Column="1"
                                           Text="{l10n:Translate UpdateAvailableShort}"
                                           Style="{StaticResource BrandText}"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"/>
                                    <Label Grid.Column="2"
                                           Text="{Binding UpdateVersion}"
                                           Style="{StaticResource Mono}"
                                           FontSize="11"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Brand}"/>
                                </Grid>
                            </Border>

                        </VerticalStackLayout>

                    </Grid>

                    <Border Grid.Row="3"
                            Style="{StaticResource CardInset}"
                            Margin="16,0,16,10"
                            Padding="14,12">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{x:Static icons:IconFont.UserCircle}"
                                   Style="{StaticResource IconLg}"
                                   TextColor="{StaticResource Brand}"
                                   VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding Username}"
                                       Style="{StaticResource Title3}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"/>
                                <Label Text="{l10n:Translate SignedIn}" Style="{StaticResource Faint}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <VerticalStackLayout Grid.Row="4" Spacing="2">
                        <Border Margin="16,0,16,0"
                                Padding="14,11"
                                Background="Transparent"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                StrokeShape="{RoundRectangle CornerRadius=11}"
                                ToolTipProperties.Text="{l10n:Translate LockNow}"
                                behaviors:Hover.Cursor="True"
                                behaviors:Hover.Background="{AppThemeBinding Light={StaticResource SurfaceHoverLight}, Dark={StaticResource SurfaceHoverDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLockNow"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" InputTransparent="True">
                                <Label Text="{x:Static icons:IconFont.Lock}"
                                       Style="{StaticResource Icon}"
                                       FontSize="15"
                                       WidthRequest="20"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                                <Label Text="{l10n:Translate LockNow}"
                                       Style="{StaticResource Muted}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Border Margin="16,0,16,4"
                                Padding="14,11"
                                Background="Transparent"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                StrokeShape="{RoundRectangle CornerRadius=11}"
                                ToolTipProperties.Text="{l10n:Translate Logout}"
                                behaviors:Hover.Cursor="True"
                                behaviors:Hover.Background="{AppThemeBinding Light={StaticResource SurfaceHoverLight}, Dark={StaticResource SurfaceHoverDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLogout"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" InputTransparent="True">
                                <Label Text="{x:Static icons:IconFont.SignOutAlt}"
                                       Style="{StaticResource Icon}"
                                       FontSize="15"
                                       WidthRequest="20"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                                <Label Text="{l10n:Translate Logout}"
                                       Style="{StaticResource Muted}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="5" Spacing="12" Margin="20,8,16,18">

                        <BoxView Style="{StaticResource Divider}" HorizontalOptions="Fill"/>

                        <Grid ColumnDefinitions="*,Auto" Margin="6,0,0,0">
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding AppVersion}" Style="{StaticResource Caption}"/>
                                <Label Text="{Binding Author}" Style="{StaticResource Faint}"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    Style="{StaticResource IconChip}"
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    ToolTipProperties.Text="{Binding RepositoryUrl}"
                                    behaviors:Hover.Cursor="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOpenRepository"/>
                                </Border.GestureRecognizers>
                                <Label Text="{x:Static icons:IconFont.Code}"
                                       Style="{StaticResource IconSm}"
                                       InputTransparent="True"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                </Grid>
            </Grid>
        </DataTemplate>
    </Shell.FlyoutContentTemplate>

    <FlyoutItem Title="Login" Route="login">
        <ShellContent ContentTemplate="{DataTemplate login:LoginPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Register" Route="register">
        <ShellContent ContentTemplate="{DataTemplate register:RegisterPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Lock" Route="lock">
        <ShellContent ContentTemplate="{DataTemplate login:LockPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Dashboard" Route="dashboard">
        <ShellContent ContentTemplate="{DataTemplate home:HomePage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Auditlogs" Route="auditlogs">
        <ShellContent ContentTemplate="{DataTemplate auditlogs:AuditlogsPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Settings" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate settings:SettingsPage}"/>
    </FlyoutItem>

</Shell>
