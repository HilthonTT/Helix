<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Helix.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:register="clr-namespace:Helix.App.Pages.Register"
    xmlns:login="clr-namespace:Helix.App.Pages.Login"
    xmlns:home="clr-namespace:Helix.App.Pages.Home"
    xmlns:settings="clr-namespace:Helix.App.Pages.Settings"
    xmlns:auditlogs="clr-namespace:Helix.App.Pages.Auditlogs"
    xmlns:behaviors="clr-namespace:Helix.App.Behaviors"
    xmlns:controls="clr-namespace:Helix.App.Controls"
    xmlns:icons="clr-namespace:Helix.App.Icons"
    xmlns:local="clr-namespace:Helix.App"
    Shell.FlyoutBehavior="Disabled"
    Shell.FlyoutWidth="236">

    <Shell.FlyoutContentTemplate>
        <DataTemplate x:DataType="local:AppShell">

            <Grid ColumnDefinitions="*,1"
                  Background="{AppThemeBinding Light={StaticResource SurfaceLightBrush}, Dark={StaticResource SurfaceDarkBrush}}">

                <!-- Hairline that separates the rail from the page canvas -->
                <BoxView Grid.Column="1"
                         Style="{StaticResource Divider}"
                         WidthRequest="1"
                         HeightRequest="-1"
                         VerticalOptions="Fill"/>

                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                      RadioButtonGroup.GroupName="Menu"
                      RadioButtonGroup.SelectedValue="{Binding SelectedRoute}">

                    <!-- Brand -->
                    <HorizontalStackLayout Grid.Row="0" Spacing="12" Margin="26,28,20,26">
                        <Image Source="logoipsum.png"
                               Aspect="AspectFit"
                               WidthRequest="24"
                               HeightRequest="31"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="Helix"
                                   FontFamily="{StaticResource FontSemibold}"
                                   FontSize="17"
                                   CharacterSpacing="0.4"/>
                            <Label Text="{local:Translate NasManager}" Style="{StaticResource Faint}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Primary navigation -->
                    <VerticalStackLayout Grid.Row="1" Spacing="2">
                        <VerticalStackLayout.Resources>
                            <Style TargetType="controls:NavItem">
                                <Setter Property="ControlTemplate" Value="{StaticResource NavItemTemplate}"/>
                            </Style>
                        </VerticalStackLayout.Resources>

                        <Label Text="{local:Translate Menu}"
                               Style="{StaticResource Overline}"
                               Margin="26,0,0,8"/>

                        <controls:NavItem Value="dashboard"
                                          Glyph="{x:Static icons:IconFont.ThLarge}"
                                          Content="{local:Translate Dashboard}"
                                          CheckedChanged="OnMenuItemChanged"/>

                        <controls:NavItem Value="auditlogs"
                                          Glyph="{x:Static icons:IconFont.History}"
                                          Content="{local:Translate Auditlogs}"
                                          CheckedChanged="OnMenuItemChanged"/>

                        <controls:NavItem Value="settings"
                                          Glyph="{x:Static icons:IconFont.Cog}"
                                          Content="{local:Translate Settings}"
                                          CheckedChanged="OnMenuItemChanged"/>
                    </VerticalStackLayout>

                    <!-- Signed-in user -->
                    <Border Grid.Row="3"
                            Style="{StaticResource CardInset}"
                            Margin="16,0,16,10"
                            Padding="14,12">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{x:Static icons:IconFont.UserCircle}"
                                   Style="{StaticResource IconLg}"
                                   TextColor="{StaticResource Brand}"
                                   VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding Username}"
                                       Style="{StaticResource Title3}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"/>
                                <Label Text="{local:Translate SignedIn}" Style="{StaticResource Faint}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Sign out -->
                    <Border Grid.Row="4"
                            Margin="16,0,16,4"
                            Padding="14,11"
                            Background="Transparent"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="{RoundRectangle CornerRadius=11}"
                            ToolTipProperties.Text="{local:Translate Logout}"
                            behaviors:Hover.Cursor="True"
                            behaviors:Hover.Background="{AppThemeBinding Light={StaticResource SurfaceHoverLight}, Dark={StaticResource SurfaceHoverDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogout"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12" InputTransparent="True">
                            <Label Text="{x:Static icons:IconFont.SignOutAlt}"
                                   Style="{StaticResource Icon}"
                                   FontSize="15"
                                   WidthRequest="20"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                            <Label Text="{local:Translate Logout}"
                                   Style="{StaticResource Muted}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Footer -->
                    <VerticalStackLayout Grid.Row="5" Spacing="12" Margin="20,8,16,18">

                        <BoxView Style="{StaticResource Divider}" HorizontalOptions="Fill"/>

                        <Grid ColumnDefinitions="*,Auto" Margin="6,0,0,0">
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding AppVersion}" Style="{StaticResource Caption}"/>
                                <Label Text="{Binding Author}" Style="{StaticResource Faint}"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    Style="{StaticResource IconChip}"
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    ToolTipProperties.Text="{Binding RepositoryUrl}"
                                    behaviors:Hover.Cursor="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOpenRepository"/>
                                </Border.GestureRecognizers>
                                <Label Text="{x:Static icons:IconFont.Code}"
                                       Style="{StaticResource IconSm}"
                                       InputTransparent="True"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                </Grid>
            </Grid>
        </DataTemplate>
    </Shell.FlyoutContentTemplate>

    <FlyoutItem Title="Login" Route="login">
        <ShellContent ContentTemplate="{DataTemplate login:LoginPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Register" Route="register">
        <ShellContent ContentTemplate="{DataTemplate register:RegisterPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Dashboard" Route="dashboard">
        <ShellContent ContentTemplate="{DataTemplate home:HomePage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Auditlogs" Route="auditlogs">
        <ShellContent ContentTemplate="{DataTemplate auditlogs:AuditlogsPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Settings" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate settings:SettingsPage}"/>
    </FlyoutItem>

</Shell>
